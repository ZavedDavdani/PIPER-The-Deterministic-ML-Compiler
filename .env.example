# PIPER — Environment Configuration Template
#
# Copy this file to .env and edit as needed.
# The backend loads this file automatically at startup (see app/env.py).
#
# Docker: docker-compose.yml reads this file automatically.

# -- LLM Provider Selection ----------------------------------------------------

# LLM provider: openai or ollama
PIPER_LLM_PROVIDER=openai

# -- OpenAI (when PIPER_LLM_PROVIDER=openai) -----------------------------------

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=
PIPER_OPENAI_TIMEOUT_SECONDS=120

# -- Gemini (when PIPER_LLM_PROVIDER=gemini) -----------------------------------

GEMINI_API_KEY=...
GEMINI_MODEL=<your-gemini-model>
PIPER_GEMINI_TIMEOUT_SECONDS=120

# -- Ollama (when PIPER_LLM_PROVIDER=ollama) -----------------------------------

# URL of the running Ollama server.
PIPER_OLLAMA_HOST=http://localhost:11434
# Alias supported by the backend:
# OLLAMA_HOST=http://localhost:11434

# Planner model to pull from Ollama and use for planning.
PIPER_LLM_MODEL=qwen3:4b
# Alias supported by the backend:
# OLLAMA_MODEL=qwen3:8b

# Per-socket-operation timeout for a single Ollama HTTP call (seconds).
# Note: this does NOT bound total wall-clock duration -- see PIPER_OLLAMA_TOTAL_DEADLINE_SECONDS.
PIPER_OLLAMA_TIMEOUT_SECONDS=600.0

# Total wall-clock deadline for one generate_plan() call (seconds).
PIPER_OLLAMA_TOTAL_DEADLINE_SECONDS=900.0

# How long Ollama should keep the model loaded after each call.
PIPER_OLLAMA_KEEP_ALIVE=10m

# -- Storage -------------------------------------------------------------------

# Run store backend: "sqlite" (default, persistent) or "memory" (in-process, no persistence).
# Tests always use "memory" -- see backend/pytest.ini.
PIPER_RUN_STORE=sqlite

# Path to the SQLite database file (relative to the working directory).
PIPER_SQLITE_PATH=data/piper_runs.sqlite

# Directory for exported ML artifact bundles (pipeline.joblib, notebooks, etc.).
PIPER_ARTIFACT_DIR=artifacts

# -- API / Frontend ------------------------------------------------------------

# Comma-separated CORS origins the FastAPI backend will accept.
PIPER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port mappings (Docker Compose only; ignored by uvicorn directly).
PIPER_BACKEND_PORT=8000
PIPER_FRONTEND_PORT=5173
