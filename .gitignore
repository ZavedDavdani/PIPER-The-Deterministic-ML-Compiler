# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Environment — NEVER commit secrets or local overrides
.env
.env.local
.env.*.local

# Data — raw dataset kept in git; processed is regenerable
data/processed/*
!data/processed/.gitkeep
# SQLite database generated at runtime
data/*.sqlite
*.sqlite

# Node / frontend build output
node_modules/
dist/

# Generated ML artifact bundles (created locally at runtime)
/artifacts/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Duplicate patterns (belt-and-suspenders)
__pycache__/
*.pyc
